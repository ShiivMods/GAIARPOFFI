{
  "name": "gaiarp",
  "version": "0.1.0-dev.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:auth": "node --experimental-strip-types --test tests/local-auth.test.ts",
    "test:combat": "node --experimental-strip-types --test tests/combat.test.ts",
    "test:combat:db": "node --experimental-strip-types --test tests/combat-db.test.ts",
    "test": "npm run test:auth && npm run test:combat && npm run test:combat:db && npm run test:combat:experience",
    "assets:sync": "node scripts/sync-combat-assets.mjs",
    "predev": "node scripts/sync-combat-assets.mjs",
    "test:combat:experience": "node --experimental-strip-types --test tests/combat-experience.test.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3"
  }
}
